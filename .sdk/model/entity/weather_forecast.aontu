                or: "forecast_day"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "forecast_hour"
                or: "forecast_hour"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "forecast_minutely_15"
                or: "forecast_minutely_15"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "hourly"
                or: "hourly"
                r: false
                t: "`$ARRAY`"
              }
              {
                ex: 52.52
                k: "query"
                n: "latitude"
                or: "latitude"
                r: true
                t: "`$NUMBER`"
              }
              {
                ex: 13.41
                k: "query"
