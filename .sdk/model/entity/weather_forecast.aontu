                or: "start_minutely_15"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "celsius"
                k: "query"
                n: "temperature_unit"
                or: "temperature_unit"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "iso8601"
                k: "query"
                n: "timeformat"
                or: "timeformat"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "auto"
                k: "query"
                n: "timezone"
                or: "timezone"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "kmh"
                k: "query"
