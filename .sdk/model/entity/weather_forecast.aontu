    latitude: {
      fo: "float"
      h: "Latitude"
      n: "latitude"
      r: false
      sh: "WGS84 latitude of the location"
      t: "`$NUMBER`"
    }
    longitude: {
      fo: "float"
      h: "Longitude"
      n: "longitude"
      r: false
      sh: "WGS84 longitude of the location"
      t: "`$NUMBER`"
    }
    timezone: {
      h: "Timezone"
      n: "timezone"
      r: false
      sh: "Timezone identifier"
      t: "`$STRING`"
    }
    timezone_abbreviation: {
      h: "Timezone Abbreviation"
      n: "timezone_abbreviation"
      r: false
      sh: "Timezone abbreviation"
      t: "`$STRING`"
    }
    utc_offset_seconds: {
      h: "Utc Offset Seconds"
      n: "utc_offset_seconds"
      r: false
      sh: "UTC offset in seconds"
      t: "`$INTEGER`"
    }
  }

  name: "weather_forecast"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/forecast"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "apikey"
                or: "apikey"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "land"
                k: "query"
                n: "cell_selection"
                or: "cell_selection"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "current"
                or: "current"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "daily"
                or: "daily"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "elevation"
                or: "elevation"
                r: false
                t: "`$NUMBER`"
              }
              {
                ex: "2022-06-30"
                k: "query"
                n: "end_date"
                or: "end_date"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2022-06-30T12:00"
