                t: "`$STRING`"
              }
              {
                ex: "2022-06-30"
                k: "query"
                n: "start_date"
                or: "start_date"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2022-06-30T12:00"
                k: "query"
                n: "start_hour"
                or: "start_hour"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "2022-06-30T12:00"
                k: "query"
