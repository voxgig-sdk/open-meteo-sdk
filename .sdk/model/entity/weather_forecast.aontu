              "start_date"
              "start_hour"
              "start_minutely_15"
              "temperature_unit"
              "timeformat"
              "timezone"
              "wind_speed_unit"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "forecast"
            }
          ]
          t: {
            req: "`reqdata`"
