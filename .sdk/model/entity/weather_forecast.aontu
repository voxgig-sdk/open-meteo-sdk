# Entity: weather_forecast

main: kit: entity: weather_forecast: {

  alias: field: {}

  fields: {
    current: {
      h: "Current"
      n: "current"
      r: false
      sh: "Current weather conditions"
      t: "`$OBJECT`"
    }
    current_units: {
      h: "Current Units"
      n: "current_units"
      r: false
      sh: "Units for current weather variables"
      t: "`$OBJECT`"
    }
    daily: {
      h: "Daily"
