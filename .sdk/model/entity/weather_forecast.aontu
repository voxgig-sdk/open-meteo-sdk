      h: "Daily Units"
      n: "daily_units"
      r: false
      sh: "Units for daily weather variables"
      t: "`$OBJECT`"
    }
    elevation: {
      fo: "float"
      h: "Elevation"
      n: "elevation"
      r: false
      sh: "Elevation in meters above sea level"
      t: "`$NUMBER`"
    }
    generationtime_ms: {
      fo: "float"
      h: "Generationtime Ms"
      n: "generationtime_ms"
      r: false
      sh: "Generation time of the weather data in milliseconds"
      t: "`$NUMBER`"
    }
    hourly: {
      h: "Hourly"
      n: "hourly"
      r: false
      sh: "Hourly weather data"
      t: "`$OBJECT`"
    }
    hourly_units: {
      h: "Hourly Units"
