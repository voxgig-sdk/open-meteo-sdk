              }
            ]
          }
          m: "GET"
          o: "/v1/forecast"
          q: {
            exist: [
              "apikey"
              "cell_selection"
              "current"
              "daily"
              "elevation"
              "end_date"
              "end_hour"
              "end_minutely_15"
