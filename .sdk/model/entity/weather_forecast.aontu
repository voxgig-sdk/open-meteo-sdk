                or: "longitude"
                r: true
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "model"
                or: "model"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 0
                k: "query"
                n: "past_day"
                or: "past_day"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "past_hour"
